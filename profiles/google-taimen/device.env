# porthole device profile — Google Pixel 2 XL (taimen, MSM8998 / Snapdragon 835)
#
# The reference profile. Every value here was paid for during the taimen port;
# where a key encodes a trap, brain/traps/ has the note and the evidence.
#
# See profiles/_template/device.env for what each key means.

# ------------------------------------------------------------------ identity --

PORTHOLE_DEVICE_NAME="Google Pixel 2 XL"
PORTHOLE_VENDOR="Google"
PORTHOLE_CODENAME="google-taimen"
PORTHOLE_YEAR="2017"
PORTHOLE_SOC="msm8998"
PORTHOLE_ARCH="aarch64"

# ---------------------------------------------------------------- A/B slots --

PORTHOLE_HAS_AB_SLOTS="1"
PORTHOLE_ACTIVE_SLOT="b"
PORTHOLE_SLOT_FORBIDDEN="a"      # slot a has no good image — NEVER set_active a
PORTHOLE_BOOT_RETRIES="3"        # the every-3rd-boot drop to the bootloader is
                                 # this counter reaching 0, not a glitch.
                                 # set_active clears unbootable AND resets it, so
                                 # re-arming is the whole fix on the way out.

# -------------------------------------------------------------------- traps --

PORTHOLE_USB_LIES_AS_FASTBOOT="1"
PORTHOLE_USB_GADGET_ID="18d1:d001"   # lsusb calls the RUNNING pmOS gadget
                                     # "fastboot". It is not. `fastboot devices`
                                     # being empty is the tell.
PORTHOLE_USB_FASTBOOT_ID="18d1:4ee0"

PORTHOLE_REBOOT_MODE_VIA_SYSCALL="1" # /usr/sbin/reboot is busybox and eats the
                                     # mode string. pon@800 is qcom,pm8998-pon
                                     # with mode-bootloader = <2> and pm8916-pon
                                     # is bound, so reboot(2) RESTART2 works and
                                     # lands in fastboot in ~9s, first try.

PORTHOLE_WATCHDOG_MAX_S="30"         # qcom,kpss-wdt on msm8998: max_tick_count
                                     # 0xFFFFF over a 32764 Hz sleep clock =
                                     # 32s ceiling. NEVER configure above 30.
                                     # RuntimeWatchdogSec=60 EINVALs and systemd
                                     # DISARMS the watchdog, announced in exactly
                                     # one journal line.

PORTHOLE_PANEL_STAYS_DARK="1"        # mainline never lights the panel; a booted
                                     # phone and a hung one look identical.

# ------------------------------------------------------------------ network --

PORTHOLE_NET_DEVICE_IP="172.16.42.1"
PORTHOLE_NET_HOST_IP="172.16.42.2"

# -------------------------------------------------------------------- build --

PORTHOLE_DTB="qcom/msm8998-google-taimen"
PORTHOLE_DTB_FILE="msm8998-google-taimen.dtb"
# The name the build WRITES the config under, not a file that has to
# exist in the tree. `porthole build` copies the aport config
# (PORTHOLE_KCONFIG_FILE) into arch/*/configs/ under this name every
# run, so a tree where `git show HEAD:arch/arm64/configs/<this>` is
# empty is normal and not rot -- it cost a session an hour to
# establish that on the 7.2 branch.
PORTHOLE_DEFCONFIG="taimen_defconfig"
# 2026-08-29: moved 6.18 -> 7.2 (pristine v7.2.2 plus the 178-patch series).
# The -6.18 aport is still in pmaports and still builds; rolling back is this
# line plus `porthole build upgrade --yes`, which swaps the flavor and pushes
# the matching modules. Do not roll back with `fast`: it cannot change flavor.
PORTHOLE_KERNEL_PKG="linux-postmarketos-qcom-msm8998-7.2"
PORTHOLE_DEVICE_PKG="device-google-taimen"
PORTHOLE_FW_PKG="firmware-google-taimen"
PORTHOLE_KERNEL_BRANCH="taimen-v7.2"
# Only used for boot images porthole builds itself (the `boot` rung /
# `fastboot boot`). The flashed aport boot.img carries the device package's
# cmdline instead, which is why /proc/cmdline never showed the blacklist.
# modprobe.blacklist=ipa was dropped 2026-08-29: it dates from the first
# config-resolution commit rather than a diagnosed fault, and ipa loads and
# brings up rmnet_ipa0 fine on the shipping kernel. Blacklisting it here only
# removed the modem data path from RAM-boots, silently.
PORTHOLE_CMDLINE="clk_ignore_unused quiet loglevel=5"

# ------------------------------------------------------------------ display --

PORTHOLE_SCREEN_WIDTH="1440"
PORTHOLE_SCREEN_HEIGHT="2880"

# -------------------------------------------------------------- boot image --

PORTHOLE_BOOTIMG_HEADER_VERSION="1"
PORTHOLE_BOOTIMG_PAGESIZE="4096"
PORTHOLE_BOOTIMG_BASE="0x00000000"
PORTHOLE_BOOTIMG_KERNEL_OFFSET="0x00008000"
PORTHOLE_BOOTIMG_RAMDISK_OFFSET="0x01000000"
PORTHOLE_BOOTIMG_TAGS_OFFSET="0x00000100"
PORTHOLE_NEEDS_DTBO="1"          # mainline needs Caleb's stub (id 2704); TWRP
                                 # needs the stock one. Mutually exclusive, read
                                 # from the ACTIVE SLOT — flash both slots.
PORTHOLE_DTBO_IMG="dtbo/dtbo_idx12.img"

# ------------------------------------------------------------------ timing --

PORTHOLE_REBOOT_BUDGET_S="120"   # ~30s forced, ~45s graceful, measured
PORTHOLE_FASTBOOT_BUDGET_S="60"  # ~9s via the RESTART2 syscall path

# The kernel aport's config file name. Not derivable: pmaports carries a 6.0,
# a 6.18 and a 7.2 config for this SoC and they differ by suffix. This must
# track PORTHOLE_KERNEL_PKG above -- the build copies it out of that aport's
# directory, so a stale value fails the build with a bare `cp: cannot stat`.
PORTHOLE_KCONFIG_FILE="config-postmarketos-qcom-msm8998-7.2.aarch64"

# ------------------------------------------------------------------ serial --
# From pkg-template/kernel-cmdline.mainline.conf. Not yet wired to a physical
# adapter on this device -- the pins have not been located.
PORTHOLE_EARLYCON="earlycon=msm_serial_dm,0xc1b0000"
PORTHOLE_SERIAL_BAUD="115200"

# ------------------------------------------------------------------ kconfig --
# The sanity list: symbols whose silent disappearance cost a boot hunt. Grown
# from the 13-symbol grep in the taimen build runbook.
PORTHOLE_KCONFIG_WATCH="CONFIG_ARM_SMMU CONFIG_QCOM_SMD_RPM CONFIG_QCOM_Q6V5_PAS CONFIG_ATH10K_SNOC CONFIG_DRM_MSM CONFIG_PANIC_TIMEOUT CONFIG_DETECT_HUNG_TASK"

# RAM-booting a freshly built kernel (`porthole build boot --kernel`) cannot
# work here: the pmOS root is a subpartition image inside /dev/sda13, so the
# initramfs needs loop.ko, and a rebuilt kernel refuses every module on the
# device. Naming the module makes `tkboot --kernel` refuse instead of
# stranding the phone in the initramfs debug shell.
PORTHOLE_RAMBOOT_NEEDS_MODULES=loop
