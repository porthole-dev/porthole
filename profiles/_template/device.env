# porthole device profile — TEMPLATE
#
# Copy this with `porthole new-device <codename>`, then fill it in as you learn.
# Every key is listed even when you cannot answer it yet: an empty key you can
# see is a question you know to ask, and a key that is simply absent is not.
#
# Committed to git. Nothing host-specific or personal goes here — your username,
# your IP and your tool paths live in ~/.config/porthole/config.env instead.
#
# Keys marked (TRAP) turn a lesson from a previous port into behaviour. Getting
# one wrong does not produce an error; it produces a confident wrong answer.
# Read brain/traps/ before setting them.

# ------------------------------------------------------------------ identity --

PORTHOLE_DEVICE_NAME=""          # "Google Pixel 2 XL"
PORTHOLE_VENDOR=""               # "Google"
PORTHOLE_CODENAME=""             # must equal this directory's name
PORTHOLE_YEAR=""
PORTHOLE_SOC=""                  # "msm8998"
PORTHOLE_ARCH="aarch64"

# ---------------------------------------------------------------- A/B slots --
# From `fastboot getvar all`: look for slot-count / current-slot.
# If the device has no slots leave PORTHOLE_HAS_AB_SLOTS=0 and skip the rest.

PORTHOLE_SLOTS_PROBED=""         # (TRAP) set by `new-device --from-fastboot`.
                                 # HAS_AB_SLOTS="0" is BOTH the shipped default
                                 # and a real answer, so without this witness a
                                 # device nobody has asked looks identical to a
                                 # device with no slots -- and the A/B safety
                                 # milestone completes itself before you have
                                 # flashed anything.
PORTHOLE_HAS_AB_SLOTS="0"
PORTHOLE_ACTIVE_SLOT=""          # the slot you keep a known-good image in
PORTHOLE_SLOT_FORBIDDEN=""       # (TRAP) a slot with NO good image. porthole
                                 # refuses to set_active this one. Leave empty
                                 # only once you are sure both slots are safe.
PORTHOLE_BOOT_RETRIES=""         # (TRAP) `set_active` arms a slot with N boot
                                 # retries. Nothing in pmOS reports a successful
                                 # boot, so the bootloader scores EVERY boot as
                                 # failed and decrements. At 0 it keeps the
                                 # device. That is the "roughly every Nth boot
                                 # lands in the bootloader" cadence — a
                                 # countdown, not a glitch.

# -------------------------------------------------------------------- traps --

PORTHOLE_USB_LIES_AS_FASTBOOT="0"  # (TRAP) 1 if lsusb labels the RUNNING pmOS
                                   # USB gadget as a fastboot device. When 1,
                                   # USB IDs cannot tell a booted device from a
                                   # bootloader and `fastboot devices` is the
                                   # only reliable discriminator.
PORTHOLE_USB_GADGET_ID=""          # "18d1:d001" — the ID it lies with
PORTHOLE_USB_FASTBOOT_ID=""        # the ID in the real bootloader

PORTHOLE_REBOOT_MODE_VIA_SYSCALL="0"
                                   # (TRAP) 1 if /usr/sbin/reboot is busybox.
                                   # Its applet is `reboot [-d DELAY] [-nf]` and
                                   # takes NO mode argument, so `reboot
                                   # bootloader` silently discards the word and
                                   # gives you a plain reboot. Needs a PMIC pon
                                   # node with mode-bootloader and a driver bound
                                   # to it; porthole then issues reboot(2)
                                   # RESTART2 itself via python3 on the device.

PORTHOLE_WATCHDOG_MAX_S=""         # (TRAP) hardware ceiling of the SoC watchdog.
                                   # WDIOC_SETTIMEOUT above it returns EINVAL and
                                   # systemd's response is to DISARM the watchdog
                                   # and close /dev/watchdog — it does not clamp.
                                   # /sys/class/watchdog/watchdog0/timeout still
                                   # reads your requested value the whole time it
                                   # is off; only `state` discriminates.

PORTHOLE_PANEL_STAYS_DARK="0"      # (TRAP) 1 while mainline never lights the
                                   # panel. A booted device and a hung one then
                                   # look identical. Never judge a boot by the
                                   # screen; check `ip addr` / `fastboot devices`.

# ------------------------------------------------------------------ network --
# The pmOS USB gadget defaults. Only change these if the device differs.

PORTHOLE_NET_DEVICE_IP="172.16.42.1"
PORTHOLE_NET_HOST_IP="172.16.42.2"

# -------------------------------------------------------------------- build --

PORTHOLE_DTB=""                  # "qcom/msm8998-google-taimen"
PORTHOLE_DTB_FILE=""             # "msm8998-google-taimen.dtb"
PORTHOLE_DEFCONFIG=""            # "taimen_defconfig"
PORTHOLE_KERNEL_PKG=""           # the aport you build; MUST name the same
                                 # kernel series your tree is on
PORTHOLE_DEVICE_PKG=""           # "device-google-taimen"
PORTHOLE_FW_PKG=""               # "firmware-google-taimen"
PORTHOLE_KERNEL_BRANCH=""        # the branch that is the product
PORTHOLE_CMDLINE=""              # kernel cmdline for boot-image experiments

# ------------------------------------------------------------------ display --

PORTHOLE_SCREEN_WIDTH=""
PORTHOLE_SCREEN_HEIGHT=""

# -------------------------------------------------------------- boot image --
# From the downstream mkbootimg args or an unpacked stock boot.img.
# Do NOT guess these: a wrong offset produces a device that does not boot and
# gives you no diagnostic at all.

PORTHOLE_BOOTIMG_HEADER_VERSION=""
PORTHOLE_BOOTIMG_PAGESIZE=""
PORTHOLE_BOOTIMG_BASE=""
PORTHOLE_BOOTIMG_KERNEL_OFFSET=""
PORTHOLE_BOOTIMG_RAMDISK_OFFSET=""
PORTHOLE_BOOTIMG_TAGS_OFFSET=""
PORTHOLE_NEEDS_DTBO="0"          # (TRAP) 1 if the bootloader reads a device-tree
                                 # overlay from a dtbo partition and the mainline
                                 # one differs from stock. They are mutually
                                 # exclusive, and the bootloader reads dtbo from
                                 # the ACTIVE SLOT — so flash both slots. Getting
                                 # it wrong bounces you to fastboot in ~3s and
                                 # looks exactly like a bad kernel.
PORTHOLE_DTS_INCLUDES=""         # extra -I paths for `porthole verify`, space
                                 # separated, relative to WORKDIR or absolute.
                                 # A board .dts pulls dt-bindings from a kernel
                                 # tree that may not be under the workdir at
                                 # all, and those paths cannot be guessed.
PORTHOLE_DTS_DEPS=""             # .dtsi files the board .dts includes, relative
                                 # to the dts dir. (TRAP) without these a dtb
                                 # that did not rebuild after an SoC dtsi edit
                                 # passes the staleness check silently.
PORTHOLE_DTC_BASELINE=""         # where to keep the dtc warning baseline
                                 # (default <workdir>/dts/dtc-baseline.txt)
PORTHOLE_DTC_IGNORE=""           # extra dtc checks to tolerate, space separated
PORTHOLE_KERNEL_TREE=""          # the kernel checkout, if not <workdir>/linux
PORTHOLE_ENVKERNEL=""            # path to pmbootstrap's helpers/envkernel.sh
                                 # if it is not in a place porthole finds
PORTHOLE_DTBO_IMG=""             # path, relative to PORTHOLE_WORKDIR

# ------------------------------------------------------------------ timing --
# Measured, not guessed. `porthole doctor --bench` prints what you actually get.

PORTHOLE_REBOOT_BUDGET_S="120"   # deadline for a normal reboot to come back
PORTHOLE_FASTBOOT_BUDGET_S="60"  # deadline to reach the bootloader

# The kernel aport config file name, if it is not config-postmarketos-<soc>.<arch>
PORTHOLE_KCONFIG_FILE=""

# ------------------------------------------------------------------ serial --
# A UART is the only channel that works before the kernel reaches driver probe,
# and the only one that says anything when it dies early. `porthole serial
# hardware` explains how to get one onto a phone.

PORTHOLE_EARLYCON=""             # e.g. "earlycon=msm_serial_dm,0xc1b0000"
                                 # the UART register base, read from the SoC dtsi
PORTHOLE_SERIAL_BAUD="115200"

# ------------------------------------------------------------------ kconfig --
# Symbols that MUST survive config regeneration. olddefconfig resolves an unmet
# dependency by DROPPING the symbol silently, and the feature is then simply
# missing at runtime with no diagnostic. `porthole kconfig diff` fails if any of
# these vanish.
PORTHOLE_KCONFIG_WATCH=""        # e.g. "CONFIG_ARM_SMMU CONFIG_QCOM_SMD_RPM"
