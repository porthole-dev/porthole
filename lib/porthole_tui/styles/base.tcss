/* lib/porthole_tui/styles/base.tcss
 *
 * Layout, spacing and focus only. Colour lands in a later plan with themes.py;
 * until then everything uses Textual's own design tokens so the app is legible
 * in both light and dark terminals from the first commit.
 */

#body { height: 1fr; }

Rail {
    width: 22;
    dock: left;
    padding: 1 2;
    border-right: solid $panel;
}
Rail .rail--heading { text-style: bold; color: $text-muted; }
Rail .rail--phase { height: 1; }
Rail .rail--phase.-current { text-style: bold; color: $accent; }
Rail .rail--section { height: 1; }
Rail .rail--section.-active { text-style: bold; background: $boost; }

#content { padding: 1 2; height: 1fr; }

JobDrawer {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $panel;
}
JobDrawer.-expanded { height: 40%; padding: 1 2; }
JobDrawer #job-log { display: none; }
JobDrawer.-expanded #job-log { display: block; height: 1fr; }

/* Focus must be unambiguous. The old console had no border and reverse-videoed
 * the selected ROW, which says what is selected but not which pane is
 * listening -- and that ambiguity is most of why it felt flaky. */
Rail:focus-within, #content:focus-within, JobDrawer:focus-within {
    border-left: thick $accent;
}

#reader-title { text-style: bold; padding: 1 2; }
#form-command { padding: 1 2; color: $accent; }
#confirm-command { padding: 1 4; text-style: bold; color: $accent; }
.form--example { width: 100%; height: 1; }

.empty { color: $text-muted; }
.error { color: $error; text-style: bold; }
