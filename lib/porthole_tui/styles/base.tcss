/* lib/porthole_tui/styles/base.tcss
 *
 * Structure and emphasis. Semantic colour for CONTENT lives in ink.py, where a
 * call site says what a thing is -- stale, blocked, a law -- and the palette is
 * decided in one place. This file is about the frame around it: where the eye
 * goes first, which region is listening, and what is chrome rather than fact.
 *
 * Everything here resolves through Textual's design tokens ($accent, $panel,
 * $boost...) so the app follows a light terminal as well as a dark one. A
 * hard-coded background is how a TUI ends up unreadable on somebody's solarised
 * light profile.
 *
 * The restraint is deliberate: the old console was "anonymous" because its
 * chrome had no identity, not because it lacked colours. Three emphases --
 * accent for where you are, muted for provenance, a rule to separate regions --
 * carry more than a rainbow does.
 */

/* ------------------------------------------------------------------ header */

#header {
    height: 1;
    padding: 0 2;
    text-style: bold;
    color: $accent;
    background: $panel;
}
#snapshot-error {
    height: auto;
    padding: 0 2;
    color: $error;
    background: $error 12%;
}

#body { height: 1fr; }

/* -------------------------------------------------------------------- rail */

Rail {
    width: 24;
    dock: left;
    padding: 1 2;
    background: $panel 40%;
    border-right: solid $primary 30%;
}
Rail .rail--heading {
    text-style: bold;
    color: $text-muted;
    padding: 0 0 1 0;
}
Rail .rail--phase { height: 1; color: $text-muted; }
/* The phase you are on is the rail's whole reason to be docked: bring-up is a
 * sequence, and "how far along am I" must be answerable without moving. */
Rail .rail--phase.-current {
    text-style: bold;
    color: $accent;
    background: $accent 15%;
}
Rail .rail--section { height: 1; }
Rail .rail--section.-active {
    text-style: bold;
    color: $accent;
    background: $boost;
}

/* ----------------------------------------------------------------- content */

#content { padding: 1 2; height: 1fr; }

/* A catalogue's filter box is chrome until you use it: it should not compete
 * with the rows for attention while empty. */
Catalogue Input {
    border: none;
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text-muted;
}
Catalogue Input:focus {
    color: $text;
    background: $accent 20%;
}
.catalogue--count {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* The table carries the content, so it gets the room and the least chrome. */
Catalogue DataTable, #palette-rows {
    height: 1fr;
    background: transparent;
}
DataTable > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: transparent;
}
/* The cursor row is the one thing that must never be ambiguous. Accent
 * background rather than reverse video: reverse inverts the per-cell colours
 * that ink.py just spent its effort setting. */
DataTable > .datatable--cursor {
    background: $accent 25%;
    text-style: bold;
}
DataTable:focus > .datatable--cursor {
    background: $accent 45%;
}

/* ------------------------------------------------------------------ drawer */

JobDrawer {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: $panel;
    border-top: solid $primary 30%;
}
JobDrawer.-expanded { height: 40%; padding: 1 2; }
JobDrawer #job-log { display: none; }
JobDrawer.-expanded #job-log { display: block; height: 1fr; }

/* Focus must be unambiguous. The old console had no border and reverse-videoed
 * the selected ROW, which says what is selected but not which pane is
 * listening -- and that ambiguity is most of why it felt flaky. */
Rail:focus-within, #content:focus-within, JobDrawer:focus-within {
    border-left: thick $accent;
}

/* ------------------------------------------------------------------ modals */

/* Opaque, all of them. Textual's default modal background is translucent, so
 * the main screen showed through on any row the modal did not paint over --
 * the rail's clipped labels rendered across a Reader's title line. */
Reader, HelpScreen, ArgForm, FilePicker, Palette, ConfirmRun {
    background: $surface;
}

#reader-title {
    text-style: bold;
    color: $accent;
    padding: 1 2 0 2;
}
#reader-body { padding: 0 2; height: 1fr; }
#form-body { padding: 0 2; height: 1fr; }

/* The assembled command is the form's answer -- it is what will actually run,
 * so it reads as a command rather than as a caption. */
#form-command {
    padding: 1 2;
    color: $accent;
    text-style: bold;
    background: $boost;
}
#confirm-command {
    padding: 1 4;
    text-style: bold;
    color: $accent;
    background: $boost;
}
#confirm-device { padding: 0 4; color: $text-muted; }

.form--example { width: 100%; height: 1; }
.form--path-row { height: 3; }
.form--path-row Input { width: 1fr; }
.form--path-row Button { width: auto; }
#picker-tree { height: 1fr; }
#palette-query {
    border: none;
    height: 1;
    padding: 0 2;
    background: $boost;
}

.empty { color: $text-muted; text-style: italic; }
.error { color: $error; text-style: bold; }
