# tk-lib.sh is resolved at runtime relative to the script, so shellcheck cannot
# follow it statically. Every tool that sources it carries a `# shellcheck
# source=` directive for the cases where it can.
disable=SC1091

# Word splitting on $HOST and friends is intended in this codebase: they are
# single tokens by construction, and quoting them everywhere would obscure the
# places where splitting genuinely matters.
disable=SC2086

# `cmd; if [ $? -ne 0 ]` is used deliberately where the exit code must be
# observed rather than acted on immediately (see tk-device.sh).
disable=SC2181
