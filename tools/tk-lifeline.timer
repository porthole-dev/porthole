# scope: generic
# needs: -  (host only, no device)
# env: -
# exits: 0 ok · non-zero on failure
[Unit]
Description=tk-lifeline: start the USB-host reachability check 90s after boot

# The previous implementation slept 90s inside tk-lifeline.service via
# ExecStartPre=/bin/sleep 90. That is functionally identical (it does not
# gate multi-user.target either way -- nothing Requires= or Before='d it
# into the boot path) but it makes tk-lifeline.service's own activation
# duration 90s+ on EVERY boot, disarmed or not, and systemd-analyze blame
# counts that as the single largest entry in the whole boot -- 1min 30s on
# a phone that otherwise reaches graphical.target in 15s. That poisons every
# systemd-analyze reading this project takes, on a unit that isn't even the
# bottleneck. A timer moves the delay before the unit starts instead of
# inside it, so blame reports the service's real (near-zero when disarmed)
# runtime, and arming still gets the same ~90s grace period before the
# first reachability probe.
[Timer]
OnBootSec=90s
Unit=tk-lifeline.service

[Install]
WantedBy=timers.target
