#!/bin/sh
# SPDX-License-Identifier: MIT
# Reject a commit message carrying a banned attribution line: an AI named in
# Co-Authored-By/Co-developed-by, a Claude-Session: line, a session URL, a
# "Generated with [Claude Code]" line. AGENTS.md section 5.
#
# Reject, never rewrite. Assisted-by: and Signed-off-by: are the convention and
# pass untouched; this hook adds nothing and strips nothing, so the log holds
# exactly what a person wrote. The patterns live in lib/porthole_trailers.py,
# the one list CI and the issue workflow also read.
set -e
root=$(git rev-parse --show-toplevel)
python3 "$root/lib/porthole_trailers.py" --scan "$1"

# Then the message is scanned for secrets. The serial that produced
# docs/HANDOFF-contribution-rules.md reached a commit message, and no check in
# this repo had ever read one. Reject for the same reason: only a human can
# decide what a secret should be redacted TO.
exec python3 "$root/lib/porthole_secrets.py" "$1"
