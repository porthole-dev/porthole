# Host-local identity and overrides -- never committed.
.env
config.env

# Python scratch
__pycache__/
*.pyc

# Runtime state: ssh control sockets, device locks.
.run/

# Documentation build output. `porthole docs build` regenerates site-src/ from
# the command registry, the tool headers, the profile template and brain/;
# mkdocs renders site/ from that. Committing either would let a stale copy
# shadow the generated one.
site-src/
site/
mkdocs.yml

# Agent session artifacts: design specs, plans and scratch notes written during
# a working session. They record how the work was done rather than what the
# tool is, they go stale the moment the code moves, and they are not something
# a public repository should carry. Durable design belongs in docs/.
docs/superpowers/

# Device capture: raw dmesg, journal dumps, wifi-soak JSON with a real BSSID in
# every heartbeat line. tools/ph-capture.sh writes here by default and brain
# notes cite it as evidence, so it is produced constantly and is never a thing
# to publish. It was untracked but NOT ignored, which is one `git add -A` from
# a leak. See docs/HANDOFF-contribution-rules.md section 4.5.
logs/

# Agent scratch: SDD ledgers, briefs and review packages. Never a deliverable.
.superpowers/

# a5xx-gmem repro rig: lockscreen probe captures and the reference crop
# is_locked() diffs against. No regex reads a screenshot, so these are never
# tracked (porthole_secrets.py's device-capture rule) -- generate ref_lock.png
# and ref_lock_small.png locally once (grim the same region documented in
# session_state.sh against a known-unlocked screen) before using the rig.
tools/repro/a5xx-gmem/*.png
