# SPDX-License-Identifier: MIT
# The porthole workspace image.
#
# Pinned base tag, never `latest`: a sandbox that changes under you is not a
# sandbox. 3.24 is the newest Alpine release as of 2026-08-29, and it carries
# pmbootstrap 3.11.1 -- the newest upstream release tag. Bump both together,
# deliberately; the assertion at the bottom is what guards the bump.
FROM docker.io/library/alpine:3.24

# pmbootstrap comes from apk because on this base that IS the latest upstream
# release. (It is not on PyPI above 2.1.0, and Alpine 3.22 was still on 3.9.0 --
# both were reasons an earlier draft cloned from git. Neither applies here.)
#
# There is deliberately NO ccache in this list, and an earlier revision that
# had one was cargo-culting. A kernel compile does not run in this image: it
# runs as pmos inside pmbootstrap's chroot_native, a separate Alpine rootfs in
# the work dir. A package installed here is not on that rootfs and can never be
# reached from a compile, so `apk add ccache sccache` here cached exactly
# nothing and could not have. The cache the compile actually uses is armed
# INSIDE the chroot, by `_ph_arm_ccache` in tools/ph-build.sh -- there rather
# than once, because `pmbootstrap build` without --lax calls zap_buildroots(),
# which deletes chroot_native itself and would undo any one-time setup.
# brain/findings/envkernel-disables-ccache.md.
#
# android-tools is 35.0.2: Google's newer platform-tools are glibc-only and
# cannot run on musl, so this is the ceiling in an Alpine image. It is well
# beyond what the supported devices need -- do not "fix" it with the zip.
# e2fsprogs-extra carries dumpe2fs and debugfs, which porthole_image uses to
# read an assembled image BACK -- extract each partition with dd and confirm
# the filesystem carries the UUID and label we chose. An assembler that
# cannot check its own output is worse than none: the failure it would miss
# is a phone that comes up in the initramfs hunting for a root that is not
# there, which reads as a brick.
# libcap-utils carries setcap, which the e2e test uses to give a source file
# a file capability BEFORE assembly, so it can prove -- rather than assert
# in a comment -- that `mkfs.ext4 -d` carries security.capability into the
# image the same way it carries setuid and ownership. Untested, that claim
# was resting on a manual spike nobody could re-run.
# meson/ninja/pytest/dbusmock are for building and TESTING an upstream project
# in place -- xdg-desktop-portal, gnome-control-center, neard -- which is a
# different job from building an aport and is why they are not makedepends of
# anything here. Note this is NOT the ccache mistake above: that package could
# never be reached because kernel compiles run in pmbootstrap's chroot_native,
# whereas `meson setup && meson test` on an unpacked tarball runs in THIS
# image, under /work. Verified 2026-09-10, when the NFC portal's pytest suite
# had nowhere to run: neither the host nor this image had meson, and the work
# went to a distrobox instead.
#
# A project's own build deps are NOT here and should not be: xdg-desktop-portal
# alone wants flatpak-dev, pipewire-dev, gst-plugins-base-dev, geoclue-dev and
# fuse3-dev, which is a lot of image for one project. Install those on demand
# from the aport that already lists them:
#   porthole sandbox shell --command \
#     "sh -lc 'apk add \$(. /pmb/cache_git/pmaports/temp/<pkg>/APKBUILD; echo \$makedepends)'"
RUN apk add --no-cache \
      pmbootstrap \
      android-tools \
      meson ninja py3-pytest py3-dbusmock \
      e2fsprogs e2fsprogs-extra fuse2fs fuse libcap-utils \
      util-linux parted multipath-tools \
      openssh-client rsync git \
      dtc \
      python3 openssl xz tar bash coreutils

# The apk package installs the `pmb` PYTHON PACKAGE and nothing else -- 164
# files, no helpers/. But `helpers/envkernel.sh` is what every kernel build
# goes through, and it exists only in the source repo. Without this the
# workspace has a working `pmbootstrap` CLI and still cannot build a kernel,
# which is exactly how it looked to the first agent that tried.
#
# Cloned at the tag matching the installed version, so the helper and the CLI
# cannot drift apart.
RUN v="$(pmbootstrap --version)" \
 && git clone --depth 1 --branch "$v" \
      https://gitlab.postmarketos.org/postmarketOS/pmbootstrap.git \
      /opt/pmbootstrap-src \
 && test -f /opt/pmbootstrap-src/helpers/envkernel.sh \
 || (echo "FATAL: no helpers/envkernel.sh for pmbootstrap $v; the workspace cannot build a kernel without it" >&2; exit 1)

# The one upstream line this image rewrites, and the reason kernel builds here
# were uncached from the first day.
#
# envkernel builds its `make` alias as a chroot invocation with environment
# assignments in front of it, and one of them is CCACHE_DISABLE=1 (helpers/
# envkernel.sh:281 in 3.11.1). That is set per invocation, on the command
# itself, so it beats any variable an outer script exports -- and every rung
# compiles through this alias. No pmbootstrap setting reaches it either:
# `pmbootstrap`'s own ccache option governs package builds via
# pmb/build/backend.py, a different path entirely.
#
# Replaced rather than deleted, so the cache lands in the directory
# pmbootstrap already bind-mounts for it ($WORK/cache_ccache_$ARCH ->
# /mnt/pmbootstrap/ccache, pmb/config/__init__.py). Without the explicit
# CCACHE_DIR the cache would resolve through the /home/pmos/.ccache symlink
# and ccache's own legacy-directory fallback -- which works today and is not
# something to rest a build on.
#
# ASSERTED, not hoped: if a future pmbootstrap renames or moves that line the
# sed matches nothing, and the IMAGE BUILD fails here rather than the discovery
# being a session that quietly compiles uncached for a week.
RUN sed -i 's|CCACHE_DISABLE=1|CCACHE_DIR=/mnt/pmbootstrap/ccache|' \
      /opt/pmbootstrap-src/helpers/envkernel.sh \
 && grep -q 'CCACHE_DIR=/mnt/pmbootstrap/ccache' /opt/pmbootstrap-src/helpers/envkernel.sh \
 && ! grep -q 'CCACHE_DISABLE' /opt/pmbootstrap-src/helpers/envkernel.sh \
 || (echo "FATAL: envkernel.sh no longer carries CCACHE_DISABLE=1 where this image expects it; re-read helpers/envkernel.sh before assuming kernel builds are cached" >&2; exit 1)

# Rust in cross-native2 (pmbootstrap branch build/rust-cross-native2, to be
# sent upstream): cargo cross-compiles natively instead of the package falling
# back to a full QEMU build. Needed because crossdirect cannot run a build
# script that loads target libraries (bindgen's libclang), and QEMU-only took
# over 40 minutes for a gtk4-rs/libcamera-rs app. Drop this once the pmbootstrap
# release in the base image carries rust_cross_native2_env().
# ASSERTED like the envkernel edit above: a patch that no longer applies fails
# the image build instead of silently leaving Rust on the slow path.
COPY patches/pmbootstrap-rust-cross-native2.patch /tmp/
RUN site=$(python3 -c 'import os, pmb; print(os.path.dirname(os.path.dirname(pmb.__file__)))') \
 && git -C "$site" apply /tmp/pmbootstrap-rust-cross-native2.patch \
 && grep -q 'def rust_cross_native2_env' "$site/pmb/build/backend.py" \
 && rm /tmp/pmbootstrap-rust-cross-native2.patch \
 || (echo "FATAL: the Rust cross-native2 patch no longer applies to this pmbootstrap; check whether the release already carries it" >&2; exit 1)

# The load-bearing assertion. The whole zero-privilege design rests on
# `pmbootstrap install --no-image` returning before it ever reaches losetup
# (docs/SANDBOX-PROVISIONING.md). If a future pmbootstrap drops that flag, the
# IMAGE BUILD must fail here rather than the discovery happening on a device.
RUN pmbootstrap install --help 2>&1 | grep -q -- '--no-image' \
 || (echo "FATAL: this pmbootstrap has no --no-image; the sandbox design needs it" >&2; exit 1)

# pmbootstrap refuses uid 0 outright -- `pmb/__init__.py` raises "Do not run
# pmbootstrap as root!" before it looks at anything else, including the config.
# In this workspace uid 0 IS the user's own unprivileged uid on the host, which
# is the entire design, so this is the one place that refusal is wrong.
# `--as-root` skips a check that assumes root means HOST root; it grants
# nothing, and outside the container it would still be refused.
#
# The config is pinned to the work dir rather than left to $XDG_CONFIG_HOME:
# that directory holds the read-only porthole config mount and its writable
# part does not survive `sandbox down`. `porthole sandbox up` writes the file.
#
# /usr/local/bin precedes /usr/bin on PATH, so envkernel gets this too -- it
# bakes a bare `pmbootstrap` into the `make` alias it builds, and without the
# wrapper every kernel compile would go straight to the refusal.
#
# This comes AFTER the assertions above on purpose: those must exercise the
# real binary, not a wrapper pointing at a config that does not exist yet.
RUN printf '%s\n' '#!/bin/sh' \
      '# The one guard every build routes through. A chroot whose /dev was' \
      '# half-unmounted looks perfectly healthy -- and stays that way until' \
      '# something opens /dev/urandom, which on a webkit build is five hours' \
      '# in. See porthole-devnodes below for what leaves it that way.' \
      'porthole-devnodes' \
      'exec /usr/bin/pmbootstrap --as-root --config /pmb/pmbootstrap_v3.cfg "$@"' \
      > /usr/local/bin/pmbootstrap \
 && chmod +x /usr/local/bin/pmbootstrap \
 && [ "$(command -v pmbootstrap)" = /usr/local/bin/pmbootstrap ] \
 || (echo "FATAL: the wrapper does not shadow /usr/bin/pmbootstrap" >&2; exit 1)

# mknod does not work in a rootless user namespace. Not a missing capability --
# CapEff carries CAP_MKNOD in here -- the kernel refuses device-node creation
# from an unprivileged userns, on container storage and on a bind mount alike.
# Probed 2026-08-29: `mknod /tmp/n c 1 3` and `mknod /pmb/n c 1 3` are both
# EPERM.
#
# pmbootstrap needs seven nodes in EVERY chroot it creates
# (pmb/config/__init__.py: chroot_device_nodes) and shells out to the `mknod`
# BINARY, so one shim on PATH covers every chroot at any point in a build.
#
# It does NOT bind the nodes one by one. That was tried and it is a trap: the
# node comes out with the right major and minor and reads fine, but
# `open(O_CREAT)` on it returns EACCES -- and O_CREAT is what every shell
# redirection uses, so `> /dev/null` inside the chroot fails and apk dies with
# "can't create /dev/null: Permission denied". Only O_CREAT; plain O_WRONLY
# works, which is why the node looks healthy right up until something uses it.
#
# Binding the whole /dev RECURSIVELY has none of that: the nodes are then
# ordinary entries of the container's own /dev, where O_CREAT works. --rbind
# rather than --bind because the per-node mounts podman layers into that tmpfs
# are what carry the real major/minor; a plain --bind gives 0:0 and
# pmbootstrap's own verification rejects it.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# rootless mknod: give the chroot the container own /dev instead.' \
      '# Stacked ON TOP of the tmpfs pmbootstrap mounts there (mount_dev_tmpfs);' \
      '# skipping when the dir is already a mountpoint is wrong, it always is.' \
      'path=$1' \
      'dir=${path%/*}' \
      'case "$dir" in' \
      '  */dev)' \
      '    [ -c "$path" ] && exit 0' \
      '    mkdir -p "$dir"' \
      '    mount --rbind /dev "$dir" || exit 1' \
      '    [ -e "$path" ] && exit 0' \
      '    ;;' \
      'esac' \
      'exec /bin/mknod "$@"' \
      > /usr/local/bin/mknod \
 && chmod +x /usr/local/bin/mknod

# ...and pmbootstrap chmods each node right after creating it, in a separate
# call, because FreeBSD's mknod has no -m. A bind-mounted node is the HOST's
# inode -- rootless podman binds /dev/null in rather than creating one, so it
# shows as `nobody` -- and chmod on an inode you do not own is EPERM even when
# the mode you are asking for is the mode it already has. Probed: only
# dev/null appeared, and the chmod after it killed the loop before zero.
#
# So: tolerate a failed chmod ONLY when the target is a character device that
# is ALREADY in the requested mode. Everything else fails exactly as before,
# including a genuine permission problem on a regular file. This is not a
# permissive chmod; it is a chmod that knows a no-op when it sees one.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '/bin/chmod "$@" 2>/dev/null && exit 0' \
      'rc=$?' \
      'mode=$1; shift' \
      'case "$mode" in -*) exit $rc ;; esac' \
      'for p in "$@"; do' \
      '  [ -c "$p" ] || exit $rc' \
      '  cur=$(stat -c %a "$p" 2>/dev/null) || exit $rc' \
      '  [ "$cur" = "$mode" ] || [ "$cur" = "${mode#0}" ] || exit $rc' \
      'done' \
      'exit 0' \
      > /usr/local/bin/chmod \
 && chmod +x /usr/local/bin/chmod

# The binds above live in the container's MOUNT NAMESPACE, so `sandbox down`
# takes them with it and leaves empty regular files behind in the chroots. On
# the next `up` pmbootstrap would find dev/null existing, skip the shim
# entirely, and then fail its own verification with "Wrong major in
# .../dev/null" -- a chroot that worked yesterday, broken by a restart.
#
# So `porthole sandbox up` re-arms them. Idempotent: an already-bound node is
# a character device and is left alone.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# Re-give every existing chroot a /dev, and put the pmbootstrap config' \
      '# where envkernel looks for it.' \
      '#' \
      '# The /dev in a chroot is a mount, so `sandbox down` takes it with it' \
      '# and the next `up` would find an empty dev/ -- pmbootstrap would then' \
      '# fail its own major/minor check on a chroot that worked yesterday.' \
      '#' \
      '# envkernel treats a missing $XDG_CONFIG_HOME/pmbootstrap_v3.cfg as a' \
      '# first run and calls `pmbootstrap init`, which is interactive and' \
      '# cannot work here. The link points at the file the wrapper already' \
      '# passes with --config, so both see one config.' \
      'cfg=${XDG_CONFIG_HOME:-$HOME/.config}/pmbootstrap_v3.cfg' \
      'mkdir -p "$(dirname "$cfg")"' \
      '[ -e "$cfg" ] || ln -sf /pmb/pmbootstrap_v3.cfg "$cfg"' \
      '# EVERY node, not just dev/null. pmbootstrap unmounts a chroot by' \
      '# walking the per-node submounts one at a time, and it dies partway' \
      '# through -- at dev/shm, `umount: not mounted`, exit 32. Whatever it' \
      '# got through before that is GONE, back to the podman placeholder' \
      '# FILES underneath (mode 700, root, regular). Measured 2026-09-01:' \
      '# zero, urandom and tty went; null, full and random survived. So a' \
      '# probe that asks only about dev/null calls a chroot healthy that has' \
      '# no /dev/urandom at all.' \
      '#' \
      '# And nothing else re-checks, ever: the mknod shim never runs because' \
      '# pmbootstrap skips a node whose path already exists, and its own' \
      '# major/minor verification is skipped by the init_done marker. Every' \
      '# later build in that chroot runs with three dead nodes until' \
      '# something opens one -- a 5.5 h webkit2gtk-6.0 build died on its' \
      '# LAST step because WebKit could not read /dev/urandom, and the' \
      '# SIGSEGV read as a qemu-user bug. porthole issue #33.' \
      'nodes="null zero full random urandom tty"' \
      'for d in /pmb/chroot_*/dev; do' \
      '  [ -d "$d" ] || continue' \
      '  for n in $nodes; do' \
      '    [ -c "$d/$n" ] && continue' \
      '    mount --rbind /dev "$d" 2>/dev/null || true' \
      '    break' \
      '  done' \
      '  for n in $nodes; do' \
      '    [ -c "$d/$n" ] && continue' \
      '    echo "porthole: $d/$n is not a device node -- a build in this chroot will fail late and blame itself" >&2' \
      '  done' \
      'done' \
 > /usr/local/bin/porthole-devnodes \
 && chmod +x /usr/local/bin/porthole-devnodes

# envkernel does not call `pmbootstrap` off PATH. `set_alias_pmbootstrap()`
# notices it is sitting in a source tree and calls that tree's
# `pmbootstrap.py` by absolute path -- straight past /usr/local/bin and into
# "Do not run pmbootstrap as root!" on the first kernel build. The source tree
# is here only for helpers/envkernel.sh; the CLI it should run is the packaged
# one. So the entry point becomes a shim too, and the container ends up with
# exactly one way to invoke pmbootstrap.
RUN printf '%s\n' '#!/bin/sh' \
      'exec /usr/local/bin/pmbootstrap "$@"' \
      > /opt/pmbootstrap-src/pmbootstrap.py \
 && chmod +x /opt/pmbootstrap-src/pmbootstrap.py

# There is no sudo in this image and nothing to escalate to: uid 0 in here IS
# the user's unprivileged uid on the host. But scripts written for a normal
# machine call sudo anyway -- envkernel.sh does for its bind mount
# (`sudo mount --bind "$PWD" "$chroot/mnt/linux"`), which is upstream and not
# ours to change -- and `sudo: command not found` reads as a broken image
# rather than as a script asking for something it already has.
#
# So: run the command as who we already are, and REFUSE if we are somehow not
# root rather than silently doing nothing. This grants no privilege; it
# removes a word that means nothing here.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '[ "$(id -u)" = 0 ] || { echo "sudo: not available in the workspace" >&2; exit 1; }' \
      'while [ $# -gt 0 ]; do' \
      '  case $1 in' \
      '    -v) exit 0 ;;' \
      '    -u|-g) shift 2 ;;' \
      '    --) shift; break ;;' \
      '    -*) shift ;;' \
      '    *) break ;;' \
      '  esac' \
      'done' \
      '[ $# -gt 0 ] || exit 0' \
      'exec "$@"' \
      > /usr/local/bin/sudo \
 && chmod +x /usr/local/bin/sudo

# Every shim this image installs must be present. They were lost once to an
# editing slip and the failure came back as "Do not run pmbootstrap as root!"
# three commands later, which names none of them.
RUN for f in /usr/local/bin/pmbootstrap /usr/local/bin/mknod \
             /usr/local/bin/chmod /usr/local/bin/sudo \
             /usr/local/bin/porthole-devnodes /opt/pmbootstrap-src/pmbootstrap.py; do \
      test -x "$f" || (echo "FATAL: $f missing from the image" >&2; exit 1); \
    done

LABEL org.opencontainers.image.title="porthole-sandbox" \
      org.opencontainers.image.description="postmarketOS bring-up workspace"

WORKDIR /pmb
CMD ["/bin/bash"]
