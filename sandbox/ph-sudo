#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""ph-sudo -- a validating privilege broker for pmbootstrap.

WHAT THIS REPLACES
    The usual way to make pmbootstrap usable in an agentic loop is
    `Defaults:<user> timestamp_timeout=9999`, a multi-day root credential
    cache. That gives *every* process running as you -- an agent, a build
    script, a compromised dependency, a prompt injection -- silent, unlimited
    root on the host for a week.

HOW IT WORKS
    pmbootstrap escalates through a single documented hook: the PMB_SUDO
    environment variable, used as `[PMB_SUDO, *cmd]`. Point that here and every
    root request pmbootstrap makes arrives as argv, which this program
    validates before executing.

    Exactly one sudoers entry is then needed, for this file alone:

        <user> ALL=(root) NOPASSWD: /usr/local/libexec/porthole/ph-sudo

    This file must be root-owned and NOT writable by that user. Otherwise the
    agent simply edits the broker, and the whole exercise is theatre.

WHAT IT ENFORCES
    - the verb is one of a small allowlist, derived from what pmbootstrap
      actually asks for (captured empirically -- see docs/SANDBOX.md)
    - every path argument resolves inside a declared root, symlinks included
    - `sh -c` is accepted only for the one narrow shape pmbootstrap uses:
      appending a literal line to a confined file
    - mknod is limited to the standard device nodes a chroot needs
    - every request, allowed or denied, is appended to an audit log

WHAT IT HONESTLY DOES NOT STOP
    `chroot <dir> <cmd>` runs an arbitrary command as root, and root inside a
    chroot can escape a chroot. The chroot directory is confined, but the
    payload is not, so a *determined* attacker who controls what pmbootstrap
    runs inside the chroot is not contained by this program.

    That is what the container tier is for (`porthole sandbox shell`), where
    root maps to your own unprivileged uid. This broker stops accidents,
    mistakes, blast radius and casual misuse -- which is the overwhelming
    majority of the risk -- and leaves an audit trail for the rest.

    Read docs/SANDBOX.md before relying on either tier.
"""
from __future__ import annotations

import grp
import json
import os
import pwd
import re
import shlex
import sys
import time

POLICY = os.environ.get("PH_SUDO_POLICY", "/etc/porthole/sandbox.conf")
AUDIT = os.environ.get("PH_SUDO_AUDIT", "/var/log/porthole-sandbox.log")

# Set only by the test suite: report the verdict instead of exec'ing, and skip
# the euid check. The decision logic is what is under test; nothing should be
# executed to test it.
TEST_MODE = os.environ.get("PH_SUDO_TEST") == "1"

EX_DENIED = 77          # distinct from anything pmbootstrap or sudo returns
EX_MISCONFIG = 78


# --------------------------------------------------------------- diagnostics --

def deny(reason: str, argv: list[str], code: int = EX_DENIED):
    audit("DENY", argv, reason)
    print(f"ph-sudo: DENIED: {reason}", file=sys.stderr)
    print(f"ph-sudo: request: {' '.join(shlex.quote(a) for a in argv)}",
          file=sys.stderr)
    print("ph-sudo: this broker only permits pmbootstrap's own operations, "
          "confined to the declared roots.", file=sys.stderr)
    print(f"ph-sudo: policy: {POLICY}   audit: {AUDIT}", file=sys.stderr)
    print("ph-sudo: if this is legitimate, add it to the policy deliberately "
          "-- do not widen the allowlist to make an error go away.",
          file=sys.stderr)
    sys.exit(code)


def audit(verdict: str, argv: list[str], reason: str = ""):
    """Append-only record of every request. Best effort: never fail the command
    because logging failed, but say so, because a silent audit gap is worse
    than a noisy one."""
    entry = {
        "t": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "verdict": verdict,
        "uid": os.getuid(),
        "user": _username(),
        "ppid": os.getppid(),
        "argv": argv,
    }
    if reason:
        entry["reason"] = reason
    try:
        with open(AUDIT, "a") as fh:
            fh.write(json.dumps(entry) + "\n")
    except OSError as exc:
        print(f"ph-sudo: WARNING: could not write audit log: {exc}",
              file=sys.stderr)


def _username() -> str:
    for var in ("SUDO_USER", "USER", "LOGNAME"):
        if os.environ.get(var):
            return os.environ[var]
    try:
        return pwd.getpwuid(os.getuid()).pw_name
    except KeyError:
        return str(os.getuid())


# ------------------------------------------------------------------- policy --

class Policy:
    """Roots that requests may touch, read from a root-owned file.

    The policy lives outside the repo on purpose. A policy file the invoking
    user can edit is not a policy.
    """

    def __init__(self, roots: list[str], allow_chroot: bool,
                 readable: list = ()):
        self.roots = roots
        self.allow_chroot = allow_chroot
        # Host files a request may READ but never write. Kept separate from
        # roots because a root is writable and these must not be.
        self.readable = list(readable)

    def is_readable(self, path: str) -> bool:
        """A readable entry may be a file or a directory to read from.

        Prefix-matched the same way as a root, and for the same reason: a
        listed directory that only matched itself and none of its contents
        would be a quiet footgun.
        """
        resolved = _resolve_for_check(path)
        for entry in self.readable:
            if resolved == entry or resolved.startswith(entry + os.sep):
                return True
        return False

    @classmethod
    def load(cls, path: str) -> "Policy":
        try:
            st = os.stat(path)
        except OSError as exc:
            deny(f"policy file {path} is unreadable ({exc}). "
                 f"Run `porthole sandbox install`.", sys.argv[1:], EX_MISCONFIG)

        # The policy must be owned by the trusted principal -- root in real
        # use. Under test that is the invoking uid, so the semantics ("only the
        # trusted owner may edit it") stay enforced and testable without
        # needing root to run the suite.
        expect_uid = os.getuid() if TEST_MODE else 0
        if st.st_uid != expect_uid:
            deny(f"policy file {path} is not owned by "
                 f"{'root' if expect_uid == 0 else 'the trusted owner'} "
                 f"(uid {st.st_uid})", sys.argv[1:], EX_MISCONFIG)
        if st.st_mode & 0o022:
            deny(f"policy file {path} is writable by non-root (mode "
                 f"{st.st_mode & 0o777:o})", sys.argv[1:], EX_MISCONFIG)

        roots, allow_chroot, readable = [], True, []
        with open(path) as fh:
            for raw in fh:
                line = raw.split("#", 1)[0].strip()
                if not line:
                    continue
                key, _, value = line.partition("=")
                key, value = key.strip(), value.strip()
                if key == "root":
                    roots.append(os.path.realpath(os.path.expanduser(value)))
                elif key == "allow_chroot":
                    allow_chroot = value.lower() in ("1", "true", "yes")
                elif key == "readable":
                    readable.append(
                        os.path.realpath(os.path.expanduser(value)))
        if not roots:
            deny(f"policy file {path} declares no roots", sys.argv[1:],
                 EX_MISCONFIG)
        return cls(roots, allow_chroot, readable)

    def contains(self, path: str) -> bool:
        """Is this path inside a declared root, after resolving symlinks?

        Resolves the nearest existing ancestor for paths that do not exist yet
        (mkdir targets, mknod nodes). A plain string prefix check would be
        wrong twice over: `/root-evil` startswith `/root`, and a symlink inside
        the root can point anywhere.
        """
        resolved = _resolve_for_check(path)
        for root in self.roots:
            if resolved == root or resolved.startswith(root + os.sep):
                return True
        return False


def _resolve_for_check(path: str) -> str:
    """realpath, but tolerant of a target that does not exist yet.

    Walk up to the nearest existing ancestor, resolve that, then re-append the
    missing tail. Without this, `mkdir -p <root>/new/dir` would be judged on an
    unresolved string and a symlinked parent could smuggle the write out.
    """
    path = os.path.abspath(os.path.expanduser(path))
    tail: list[str] = []
    head = path
    while not os.path.lexists(head):
        head, part = os.path.split(head)
        if not part:
            break
        tail.append(part)
        if head in ("/", ""):
            break
    resolved = os.path.realpath(head)
    for part in reversed(tail):
        resolved = os.path.join(resolved, part)
    return os.path.normpath(resolved)


# ------------------------------------------------------------- verb handlers --

def looks_like_path(arg: str) -> bool:
    return arg.startswith("/") or arg.startswith("./") or arg.startswith("~")


# The device nodes a chroot legitimately needs. Anything else -- a disk, a raw
# block device, /dev/mem -- is not pmbootstrap's business and is how a confined
# write becomes an unconfined one.
ALLOWED_NODES = {
    ("c", "1", "3"): "null", ("c", "1", "5"): "zero", ("c", "1", "7"): "full",
    ("c", "1", "8"): "random", ("c", "1", "9"): "urandom",
    ("c", "5", "0"): "tty", ("c", "5", "1"): "console",
    ("c", "5", "2"): "ptmx",
}

# `sh -c` is accepted for exactly one shape, because that is the only one
# pmbootstrap uses: appending a literal line to a file. Anything else routed
# through a shell is unbounded by definition.
SH_APPEND = re.compile(r"^echo\s+(?P<text>[^|;&<>`$()]*?)\s*>>\s*(?P<path>\S+)$")

# Mount options that turn a confined mount into an unconfined one.
FORBIDDEN_MOUNT_OPTS = ("remount", "rbind", "move")

# Kernel API filesystems a chroot legitimately needs bound INTO it. These are
# not host data: they are kernel interfaces that any chroot has to have to
# function, and pmbootstrap binds them on every chroot init.
#
# The list is deliberately exact -- no /etc, no /home, no /usr, no /. Binding
# host data into a chroot would hand it to whatever runs in there, which is the
# thing this broker exists to prevent. What matters for safety is that the
# DESTINATION is confined; a permitted source is only ever mounted inward.
BIND_SOURCE_ALLOWLIST = frozenset({
    "/proc", "/sys", "/dev", "/dev/pts", "/dev/shm", "/run",
    "/sys/fs/cgroup", "/sys/kernel/debug", "/dev/null", "/dev/zero",
})


def check_paths(argv: list[str], policy: Policy, skip: int = 1) -> None:
    """Every path-looking argument must resolve inside a declared root."""
    for arg in argv[skip:]:
        if "\0" in arg:
            deny("argument contains a NUL byte", argv)
        if looks_like_path(arg) and not policy.contains(arg):
            deny(f"path escapes the declared roots: {arg}\n"
                 f"           resolves to: {_resolve_for_check(arg)}\n"
                 f"           allowed roots: {', '.join(policy.roots)}", argv)


def handle_ln(argv, policy):
    """Only what ln WRITES is confined; the targets are strings.

    Two shapes, both real pmbootstrap operations:

        ln -s /proc/self/fd/0 <chroot>/dev/stdin     TARGET LINKNAME
        ln -s usr/bin usr/sbin usr/lib <chroot>/     TARGET... DIRECTORY

    A TARGET is only text stored inside the link. Confining it would break the
    first of those and buy nothing, because any later use of the link resolves
    through _resolve_for_check anyway.

    With more than two operands the last is a directory and the links are
    created inside it as DIRECTORY/basename(TARGET) -- a basename contains no
    separator, so confining the directory confines every link made in it.
    """
    operands = [a for a in argv[1:] if not a.startswith("-")]

    # `-t DIR` names the directory explicitly, and then every operand is a
    # target rather than the last one being the destination.
    written = None
    for i, arg in enumerate(argv[1:]):
        if arg == "-t" and i + 1 < len(argv) - 1:
            written = argv[i + 2]
            break
        if arg.startswith("--target-directory="):
            written = arg.split("=", 1)[1]
            break

    if written is None:
        if len(operands) < 2:
            deny("ln must be `ln [-s] TARGET... LINKNAME|DIRECTORY`", argv)
        written = operands[-1]

    if not policy.contains(written):
        deny(f"link name escapes the declared roots: {written}\n"
             f"           resolves to: {_resolve_for_check(written)}", argv)


def handle_mount(argv, policy):
    """The destination must always be confined; the source may also be a kernel
    API filesystem, which a chroot cannot work without.

    Found by running the broker against a real `pmbootstrap chroot` on a chroot
    that had not been initialised yet: it binds /proc, /sys and /dev inward. The
    earlier capture missed it because the chroot was already set up -- a good
    argument for testing a policy end to end rather than trusting one trace.
    """
    for i, arg in enumerate(argv):
        if arg in ("-o", "--options") and i + 1 < len(argv):
            opts = argv[i + 1].split(",")
            for bad in FORBIDDEN_MOUNT_OPTS:
                if bad in opts:
                    deny(f"mount option {bad!r} is not permitted: it can move "
                         f"or re-flag a mount outside the declared roots", argv)

    operands = [a for a in argv[1:] if not a.startswith("-")]
    # Skip an option's value (`-t tmpfs`, `-o size=1M`) when collecting them.
    skip = set()
    for i, arg in enumerate(argv):
        if arg in ("-t", "--types", "-o", "--options"):
            skip.add(i + 1)
    operands = [a for i, a in enumerate(argv)
                if i > 0 and i not in skip and not a.startswith("-")]

    is_bind = "--bind" in argv or "-B" in argv
    if is_bind and len(operands) == 2:
        source, dest = operands
        if not policy.contains(dest):
            deny(f"bind destination escapes the declared roots: {dest}", argv)
        if source not in BIND_SOURCE_ALLOWLIST and not policy.contains(source):
            deny(f"bind source is neither inside the declared roots nor a "
                 f"kernel API filesystem: {source}\n"
                 f"           permitted API sources: "
                 f"{', '.join(sorted(BIND_SOURCE_ALLOWLIST))}", argv)
        return

    # Non-bind mount: the target is the last operand, and a pseudo-filesystem
    # source like `tmpfs` is a type name rather than a path.
    for operand in operands:
        if looks_like_path(operand) and not policy.contains(operand):
            deny(f"mount target escapes the declared roots: {operand}", argv)


def handle_sh(argv, policy):
    if len(argv) != 3 or argv[1] != "-c":
        deny("only `sh -c <single command>` is accepted", argv)
    m = SH_APPEND.match(argv[2].strip())
    if not m:
        deny("`sh -c` is accepted only for appending a literal line to a "
             "confined file (`echo TEXT >> PATH`). A shell command is "
             "unbounded by definition, so anything else is refused.", argv)
    path = m.group("path")
    if not policy.contains(path):
        deny(f"`sh -c` redirect target escapes the declared roots: {path}", argv)


def handle_mknod(argv, policy):
    args = [a for a in argv[1:] if not a.startswith("-")]
    if len(args) != 4:
        deny("mknod must be `mknod PATH TYPE MAJOR MINOR`", argv)
    path, kind, major, minor = args
    if not policy.contains(path):
        deny(f"mknod path escapes the declared roots: {path}", argv)
    if (kind, major, minor) not in ALLOWED_NODES:
        deny(f"mknod {kind} {major}:{minor} is not one of the standard chroot "
             f"device nodes ({', '.join(sorted(ALLOWED_NODES.values()))}). "
             f"Creating an arbitrary device node inside a confined directory "
             f"is a way out of it.", argv)
    check_paths(argv, policy)


def handle_env(argv, policy):
    """`env -i ... sh -c '<...> chroot <dir> ...'` -- pmbootstrap's chroot call.

    Only the `-i` form is accepted, and the embedded chroot target must be
    confined. See the module docstring for what this does and does not buy.
    """
    if not policy.allow_chroot:
        deny("chroot execution is disabled by policy (allow_chroot=0). "
             "Use `porthole sandbox shell`, where root maps to your own uid.",
             argv)
    joined = " ".join(argv)
    targets = re.findall(r"(?:^|\s)(?:\S*/)?chroot\s+(\S+)", joined)
    if not targets:
        deny("`env` is accepted only as pmbootstrap's chroot invocation", argv)
    for target in targets:
        target = target.strip("'\"")
        if not policy.contains(target):
            deny(f"chroot target escapes the declared roots: {target}", argv)
    audit("ALLOW-CHROOT", argv,
          "arbitrary payload inside a confined chroot; see docs/SANDBOX.md")


def handle_cp(argv, policy):
    """`cp SRC... DST`: DST is confined as always, SRC may also be a file the
    policy lists as readable.

    pmbootstrap copies the host's /etc/resolv.conf into the chroot so that the
    chroot has DNS, and that source is deliberately outside the roots. Refusing
    it stops a build dead at the first chroot.

    The two positions are NOT interchangeable, and that asymmetry is the whole
    security property:

      - as a SOURCE the file is only read. A listed file must be one the
        invoking user can already read, so root reading it discloses nothing
        new. Allowing arbitrary sources would not be safe -- `cp /etc/shadow
        <chroot>/tmp/x` would hand the user a file they cannot otherwise read.
      - as a DESTINATION it would be written as root. That is never allowed
        outside the roots, or a listed /etc/resolv.conf could be overwritten to
        hijack DNS.
    """
    operands = [a for a in argv[1:] if not a.startswith("-")]
    if len(operands) < 2:
        deny("cp must have at least a source and a destination", argv)

    for src in operands[:-1]:
        if "\0" in src:
            deny("argument contains a NUL byte", argv)
        if policy.contains(src) or policy.is_readable(src):
            continue
        deny(f"copy source escapes the declared roots and is not listed as "
             f"readable: {src}\n"
             f"           resolves to: {_resolve_for_check(src)}", argv)

    dst = operands[-1]
    if not policy.contains(dst):
        deny(f"copy destination escapes the declared roots: {dst}\n"
             f"           resolves to: {_resolve_for_check(dst)}", argv)


def handle_losetup(argv, policy):
    # `losetup --json --list` is read-only enumeration and safe. Attaching or
    # detaching a loop device is not: it can expose any file as a block device.
    if all(a.startswith("-") for a in argv[1:]):
        return
    check_paths(argv, policy)


HANDLERS = {
    "ln": handle_ln,
    "mount": handle_mount,
    "sh": handle_sh,
    "mknod": handle_mknod,
    "env": handle_env,
    "losetup": handle_losetup,
    "cp": handle_cp,
}

# Verbs whose every path argument simply has to be confined. Derived from an
# empirical capture of a full pmbootstrap chroot + shutdown cycle; see
# docs/SANDBOX.md for the method and the raw list.
SIMPLE_VERBS = {
    "umount", "rm", "mkdir", "chmod", "chown", "touch", "install",
    "mv", "rmdir", "sed", "tee", "dd", "sync", "truncate", "stat", "readlink",
}


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return EX_MISCONFIG

    # Refuse to run as anything but a root-invoked broker: if this is somehow
    # executed without privilege the caller should hear about it rather than
    # silently getting a different result.
    if os.geteuid() != 0 and not TEST_MODE:
        print("ph-sudo: must be invoked through sudo (it is the broker, not "
              "the client)", file=sys.stderr)
        return EX_MISCONFIG

    policy = Policy.load(POLICY)

    verb = os.path.basename(argv[0])
    # An absolute argv[0] must itself be a normal system binary; a path into a
    # user-writable directory would let the caller supply the "verb".
    if "/" in argv[0]:
        real = os.path.realpath(argv[0])
        if not real.startswith(("/usr/bin/", "/usr/sbin/", "/bin/", "/sbin/")):
            deny(f"executable must live in a system bin directory: {argv[0]}",
                 argv)

    handler = HANDLERS.get(verb)
    if handler:
        handler(argv, policy)
    elif verb in SIMPLE_VERBS:
        check_paths(argv, policy)
    else:
        deny(f"verb {verb!r} is not in the allowlist. pmbootstrap's observed "
             f"root operations are: "
             f"{', '.join(sorted(set(HANDLERS) | SIMPLE_VERBS))}", argv)

    audit("ALLOW", argv)

    if TEST_MODE:
        print(f"ALLOW {' '.join(shlex.quote(a) for a in argv)}")
        return 0

    os.execvp(argv[0], argv)
    return 1      # unreachable: execvp replaces the process or raises


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as exc:
        print(f"ph-sudo: exec failed: {exc}", file=sys.stderr)
        sys.exit(EX_MISCONFIG)
