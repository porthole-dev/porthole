#!/usr/bin/env python3
"""porthole -- postmarketOS device bring-up toolkit.

The CLI is for bootstrapping, introspection and machine-readable output. It is
deliberately NOT on any tool's hot path: the tools source lib/porthole.sh or
import lib/porthole.py and resolve config themselves, which costs under a
millisecond. Shelling out to this would cost a python interpreter start per
probe, in loops that run hundreds of them.

Every read verb takes --json. Colour only on a tty, never under NO_COLOR.
Nothing prompts unless stdin is a tty, so an agent can bootstrap headless.

Exit codes are an API:
    0   ok
    1   the thing under test failed (a doctor check, an unknown key)
    64  usage error
    75  could not get the device lock (retryable)
    76  device in the wrong state (waiting will not fix it)
    124 killed at the hold ceiling
"""
from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import porthole  # noqa: E402

ROOT = porthole.find_root()

VERBS = {
    "init": "set your identity and pick a device; writes config.env",
    "doctor": "check host tools, profile, device reachability and sudo -n",
    "config": "print the resolved config and where each value came from",
    "devices": "list device profiles",
    "new-device": "scaffold a profile for a device nobody has ported yet",
    "brain": "search the second brain",
    "run": "run a tool with the config applied",
}


# ------------------------------------------------------------------ output --

def _colour_ok() -> bool:
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _colour_ok() else text


MARK = {"ok": ("ok", "32"), "warn": ("warn", "33"),
        "fail": ("FAIL", "31"), "skip": ("skip", "90")}


def die(message: str, code: int = 1):
    print(f"porthole: {message}", file=sys.stderr)
    raise SystemExit(code)


def load(argv_device: str | None = None) -> porthole.Config:
    env = dict(os.environ)
    if argv_device:
        env["PORTHOLE_DEVICE"] = argv_device
    try:
        return porthole.load_config(root=ROOT, env=env)
    except porthole.ProfileNotFound as exc:
        # A traceback here would bury the one line that says what to do.
        die(str(exc))


def derived(cfg: porthole.Config) -> porthole.Config:
    """Add the composed values so `config` shows what tools will actually use."""
    for key, value in (("PHONE", porthole.resolve_phone(cfg)),
                       ("HOST", porthole.resolve_host(cfg))):
        if not cfg.get(key):
            cfg.set(key, value, "derived")
    return cfg


# ------------------------------------------------------------------ config --

def cmd_config(args) -> int:
    cfg = derived(load(getattr(args, 'device', None)))
    if args.key:
        if args.key not in cfg:
            die(f"no such key: {args.key}")
        print(cfg[args.key])
        return 0
    if args.json:
        print(json.dumps({k: {"value": cfg[k], "source": cfg.source(k)}
                          for k in sorted(cfg)}, indent=2))
        return 0
    width = max((len(k) for k in cfg), default=0)
    for key in sorted(cfg):
        print(f"{key:<{width}}  {cfg[key]}"
              f"{paint('   # ' + cfg.source(key), '90')}")
    return 0


# ----------------------------------------------------------------- devices --

def _profile_summary(codename: str, active: str) -> dict:
    path = ROOT / "profiles" / codename / "device.env"
    vals = porthole.parse_env(path.read_text()) if path.is_file() else {}
    return {
        "codename": codename,
        "name": vals.get("PORTHOLE_DEVICE_NAME", ""),
        "soc": vals.get("PORTHOLE_SOC", ""),
        "active": codename == active,
    }


def cmd_devices(args) -> int:
    active = os.environ.get("PORTHOLE_DEVICE", "")
    if not active:
        try:
            active = porthole.load_config(root=ROOT).get("PORTHOLE_DEVICE", "")
        except porthole.ProfileNotFound:
            active = ""
    rows = [_profile_summary(n, active) for n in porthole.list_profiles(ROOT)]
    if args.json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("no device profiles yet -- create one with `porthole new-device <codename>`")
        return 0
    for row in rows:
        mark = paint("*", "32") if row["active"] else " "
        print(f"{mark} {row['codename']:<20} {row['soc']:<10} {row['name']}")
    return 0


# ------------------------------------------------------------------ doctor --

class Checks:
    """Collects verdicts. A failing check without a `fix` is a bug: doctor
    exists to replace 'the tools mysteriously do nothing' with one actionable
    line."""

    def __init__(self):
        self.rows: list[dict] = []

    def add(self, name, status, detail="", fix=""):
        assert status != "fail" or fix, f"failing check {name} offers no fix"
        self.rows.append({"name": name, "status": status,
                          "detail": detail, "fix": fix})

    def worst(self) -> str:
        for level in ("fail", "warn"):
            if any(r["status"] == level for r in self.rows):
                return level
        return "ok"


def _which(cfg, key, default):
    value = cfg.get(key) or default
    return shutil.which(value) or (value if os.path.isfile(value) else None)


def cmd_doctor(args) -> int:
    cfg = derived(load(getattr(args, 'device', None)))
    ch = Checks()

    # -- host tooling --
    for key, default, why in (
        ("FASTBOOT", "fastboot", "needed to reach and leave the bootloader"),
        ("ADB", "adb", "optional; only for talking to a stock/recovery system"),
    ):
        found = _which(cfg, key, default)
        if found:
            ch.add(f"host: {key.lower()}", "ok", found)
        elif key == "ADB":
            ch.add("host: adb", "warn", f"not found -- {why}")
        else:
            ch.add(f"host: {key.lower()}", "fail", f"not found -- {why}",
                   f"install android-tools, or set {key} in "
                   f"~/.config/porthole/config.env")

    for tool, fix in (("ssh", "install openssh-client"),
                      ("python3", "install python3")):
        if shutil.which(tool):
            ch.add(f"host: {tool}", "ok", shutil.which(tool))
        else:
            ch.add(f"host: {tool}", "fail", "not found", fix)

    pmb = shutil.which("pmbootstrap")
    if pmb:
        ch.add("host: pmbootstrap", "ok", pmb)
    else:
        ch.add("host: pmbootstrap", "warn",
               "not found -- needed to build and flash, not to probe")

    # -- profile --
    device = cfg.get("PORTHOLE_DEVICE", "")
    if not device:
        ch.add("profile", "fail", "no device selected",
               "run `porthole init --device <codename>`, or "
               "`porthole devices` to see what exists")
    else:
        ch.add("profile", "ok", device)
        blanks = [k for k in ("PORTHOLE_SOC", "PORTHOLE_CODENAME",
                              "PORTHOLE_ARCH") if not cfg.get(k)]
        if blanks:
            ch.add("profile: required keys", "fail",
                   f"unset: {', '.join(blanks)}",
                   f"fill them in profiles/{device}/device.env")
        else:
            ch.add("profile: required keys", "ok")
        if cfg.get("PORTHOLE_HAS_AB_SLOTS") == "1" and not cfg.get("PORTHOLE_ACTIVE_SLOT"):
            ch.add("profile: A/B slots", "warn",
                   "HAS_AB_SLOTS=1 but ACTIVE_SLOT is unset; "
                   "recovery from the bootloader cannot re-arm a slot")

    # -- identity --
    # Judge the resolved ssh target, not one input to it: somebody who exports
    # PHONE directly (which every taimen command line does) has a perfectly
    # good identity even though PORTHOLE_USER was never set.
    if cfg.source("PHONE") == "derived" and cfg.source("PORTHOLE_USER") == "default":
        ch.add("identity", "warn",
               f"nothing set a username, so ssh will use "
               f"'{cfg['PORTHOLE_USER']}' -- run `porthole init`")
    else:
        ch.add("identity", "ok", f"{cfg['PHONE']} (via {cfg.source('PHONE')})")

    # -- device --
    if args.no_device:
        ch.add("device: state", "skip", "--no-device")
    else:
        dev = porthole.Device(cfg)
        start = time.monotonic()
        state = dev.state()
        elapsed = (time.monotonic() - start) * 1000
        detail = f"{state} ({elapsed:.0f}ms)"
        if state == "BOOTED":
            ch.add("device: state", "ok", detail)
            rc, out, _ = dev.run_full("sudo -n true", timeout=8)
            if rc == 0:
                ch.add("device: sudo -n", "ok", "passwordless sudo works")
            else:
                # This is the single most common "every tool is broken"
                # report. sudoers-nopasswd must not ship in a device package,
                # and `sudo -n` does not prompt -- it fails. So a reflash
                # silently disables the entire toolbox.
                user = cfg["PHONE"].partition("@")[0]
                ch.add("device: sudo -n", "fail",
                       "sudo -n fails; nearly every tool calls it and -n does "
                       "not prompt, so they will all silently do nothing",
                       f"on the device, once per install:\n"
                       f"        echo '{user} ALL=(ALL) NOPASSWD: ALL' | "
                       f"sudo tee /etc/sudoers.d/99-porthole-dev\n"
                       f"        sudo chmod 0440 /etc/sudoers.d/99-porthole-dev")
        elif state == "FASTBOOT":
            ch.add("device: state", "warn",
                   f"{detail} -- in the bootloader, so nothing over ssh will work")
        elif state == "FROZEN":
            ch.add("device: state", "warn",
                   f"{detail} -- kernel alive, userspace gone; see "
                   "brain/playbooks/ for recovery")
        else:
            ch.add("device: state", "warn",
                   f"{detail} -- not reachable. Suspended, powered off, or "
                   "unplugged. Not a failure if you are working offline.")

    # -- tool headers --
    if args.tools:
        ch.rows.extend(_check_tool_headers())

    # -- benchmarks --
    if args.bench and not args.no_device:
        ch.rows.extend(_bench(cfg))

    if args.json:
        print(json.dumps({"checks": ch.rows, "verdict": ch.worst()}, indent=2))
    else:
        width = max(len(r["name"]) for r in ch.rows)
        for row in ch.rows:
            label, colour = MARK[row["status"]]
            print(f"  {paint(f'{label:>4}', colour)}  "
                  f"{row['name']:<{width}}  {row['detail']}")
            if row["fix"]:
                print(f"        {paint('fix: ' + row['fix'], '36')}")
        verdict = ch.worst()
        print()
        print({"ok": paint("everything checks out", "32"),
               "warn": paint("usable, with warnings", "33"),
               "fail": paint("something needs fixing", "31")}[verdict])
    return 1 if ch.worst() == "fail" else 0


HEADER_RE = re.compile(r"^#\s*(scope|needs|env|exits):", re.M)


def _check_tool_headers() -> list[dict]:
    """Every tool must document scope/needs/env/exits in its first 30 lines, so
    `head -20 <tool>` answers an agent's questions without opening the file."""
    rows, missing = [], []
    tools = sorted(p for p in (ROOT / "tools").glob("tk-*")
                   if p.is_file() and not p.is_symlink())
    tools += sorted(p for p in (ROOT / "tools").glob("ph-*") if p.is_file())
    for tool in tools:
        try:
            head = "".join(tool.read_text(errors="replace").splitlines(True)[:30])
        except OSError:
            continue
        if "scope:" not in head:
            missing.append(tool.name)
    if not tools:
        rows.append({"name": "tools: header", "status": "skip",
                     "detail": "no tools yet", "fix": ""})
    elif missing:
        rows.append({"name": "tools: header", "status": "fail",
                     "detail": f"{len(missing)} of {len(tools)} lack a "
                               f"scope: line: {', '.join(missing[:6])}"
                               + (" ..." if len(missing) > 6 else ""),
                     "fix": "add the standard header block; see "
                            "docs/CONTRIBUTING.md"})
    else:
        rows.append({"name": "tools: header", "status": "ok",
                     "detail": f"all {len(tools)} documented", "fix": ""})
    return rows


def _bench(cfg) -> list[dict]:
    """Measure the budgets in docs/PERFORMANCE.md rather than claiming them."""
    dev = porthole.Device(cfg)
    rows = []

    def timed(label, fn, budget_ms):
        start = time.monotonic()
        fn()
        ms = (time.monotonic() - start) * 1000
        rows.append({"name": f"bench: {label}",
                     "status": "ok" if ms <= budget_ms else "warn",
                     "detail": f"{ms:.0f}ms (budget {budget_ms}ms)", "fix": ""})

    dev.run("true")                                    # warm the master
    timed("ssh round trip (warm)", lambda: dev.run("true"), 30)
    timed("fastboot devices", dev.in_fastboot, 250)
    timed("device state", dev.state, 100)
    return rows


# -------------------------------------------------------------------- init --

CONFIG_TEMPLATE = """\
# porthole identity -- written by `porthole init`.
#
# This file is yours: your username, your device's address, your tool paths.
# It is never committed. Device facts live in profiles/<codename>/device.env,
# which IS committed.
#
# Anything here is overridden by the process environment, so a one-off
# `PHONE=other@host tk-foo.sh` still works without editing this.

PORTHOLE_DEVICE={device}
PORTHOLE_USER={user}
PORTHOLE_HOST={host}
PORTHOLE_SSH_PORT={port}
PORTHOLE_AGENT={agent}
{extra}"""


def _ask(prompt: str, default: str) -> str:
    """Prompt only when a human is present. An agent gets the default."""
    if not sys.stdin.isatty():
        return default
    got = input(f"{prompt} [{default}]: ").strip()
    return got or default


def cmd_init(args) -> int:
    devices = porthole.list_profiles(ROOT)
    device = args.device or _ask(
        f"device ({', '.join(devices) or 'none yet'})", devices[0] if devices else "")
    if device and device not in devices:
        die(f"no profile for {device!r}. Known: {', '.join(devices) or '(none)'}. "
            f"Create one with `porthole new-device {device}`.")

    user = args.user or _ask("ssh username on the device", "user")
    host = args.host or _ask("device IP", "172.16.42.1")
    port = args.port or "22"
    agent = args.agent or os.environ.get("USER", "")

    xdg = pathlib.Path(os.environ.get("XDG_CONFIG_HOME")
                       or pathlib.Path.home() / ".config")
    target = xdg / "porthole" / "config.env"
    if target.exists() and not args.force:
        die(f"{target} already exists. Re-run with --force to overwrite it, "
            f"or edit it directly.")

    extra = ""
    for key, value in (("FASTBOOT", shutil.which("fastboot")),
                       ("ADB", shutil.which("adb"))):
        if value:
            extra += f"{key}={value}\n"
    pmb = pathlib.Path.home() / ".local/var/pmbootstrap"
    if pmb.is_dir():
        extra += f"PORTHOLE_PMB_DIR={pmb}\n"

    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(CONFIG_TEMPLATE.format(
        device=device, user=user, host=host, port=port, agent=agent,
        extra=extra))

    print(f"wrote {target}")
    print()
    print("On the device, once per install -- porthole cannot do this for you,")
    print("and without it nearly every tool silently does nothing, because they")
    print("call `sudo -n` and -n does not prompt, it just fails:")
    print()
    print(paint(f"    echo '{user} ALL=(ALL) NOPASSWD: ALL' | "
                f"sudo tee /etc/sudoers.d/99-porthole-dev", "36"))
    print(paint("    sudo chmod 0440 /etc/sudoers.d/99-porthole-dev", "36"))
    print()
    print("This must NOT ship in a device package other people install.")
    print()
    print("Then: " + paint("porthole doctor", "1"))
    return 0


# --------------------------------------------------------------------- run --

def cmd_run(args) -> int:
    cfg = derived(load(getattr(args, 'device', None)))
    name = args.tool
    candidates = [ROOT / "tools" / name]
    if cfg.get("PORTHOLE_DEVICE"):
        candidates.insert(
            0, ROOT / "profiles" / cfg["PORTHOLE_DEVICE"] / "tools" / name)
    for path in candidates:
        if path.is_file():
            env = dict(os.environ)
            env.update({k: str(v) for k, v in cfg.items()})
            env["PORTHOLE_ROOT"] = str(ROOT)
            return subprocess.run([str(path), *args.args], env=env).returncode
    die(f"no tool named {name!r} in tools/ or the active profile's tools/")


def with_device(parser):
    """Accept --device after the verb as well as before it.

    `porthole init --device taimen` is what everyone types; requiring it before
    the verb is the kind of papercut that makes a tool feel hostile. SUPPRESS is
    load-bearing: without it argparse would helpfully overwrite a global
    --device with None whenever the subparser's own flag is absent.
    """
    parser.add_argument("--device", default=argparse.SUPPRESS,
                        help="override PORTHOLE_DEVICE")
    return parser


# ------------------------------------------------------------------- parser --

def build_parser() -> argparse.ArgumentParser:
    epilog = "verbs:\n" + "\n".join(
        f"  {v:<12} {d}" for v, d in VERBS.items())
    p = argparse.ArgumentParser(
        prog="porthole", add_help=True,
        description="postmarketOS device bring-up toolkit",
        epilog=epilog, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-d", "--device", help="override PORTHOLE_DEVICE")
    sub = p.add_subparsers(dest="verb")

    c = with_device(sub.add_parser("config", help=VERBS["config"]))
    c.add_argument("key", nargs="?")
    c.add_argument("--json", action="store_true")
    c.set_defaults(func=cmd_config)

    d = with_device(sub.add_parser("devices", help=VERBS["devices"]))
    d.add_argument("--json", action="store_true")
    d.set_defaults(func=cmd_devices)

    o = with_device(sub.add_parser("doctor", help=VERBS["doctor"]))
    o.add_argument("--json", action="store_true")
    o.add_argument("--tools", action="store_true",
                   help="also check every tool has a documented header")
    o.add_argument("--bench", action="store_true",
                   help="also measure the performance budgets")
    o.add_argument("--no-device", action="store_true",
                   help="skip everything that touches the device")
    o.set_defaults(func=cmd_doctor)

    i = with_device(sub.add_parser("init", help=VERBS["init"]))
    i.add_argument("--user")
    i.add_argument("--host")
    i.add_argument("--port")
    i.add_argument("--agent")
    i.add_argument("--force", action="store_true")
    i.set_defaults(func=cmd_init)

    r = with_device(sub.add_parser("run", help=VERBS["run"]))
    r.add_argument("tool")
    r.add_argument("args", nargs=argparse.REMAINDER)
    r.set_defaults(func=cmd_run)

    return p, sub


def main(argv: list[str]) -> int:
    parser, sub = build_parser()
    register_extra_verbs(sub)
    if not argv:
        parser.print_help()
        return 64
    if argv[0] not in ("-h", "--help") and argv[0].lstrip("-") not in \
            set(VERBS) | {"device", "d"} and not argv[0].startswith("-"):
        if argv[0] not in sub.choices:
            print(f"porthole: unknown verb {argv[0]!r}", file=sys.stderr)
            print(f"porthole: try one of: {', '.join(VERBS)}", file=sys.stderr)
            return 64
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 64
    return args.func(args)


def register_extra_verbs(sub) -> None:
    """new-device and brain live in their own modules to keep this file small.

    Imported lazily: `porthole config` should not pay to parse them.
    """
    n = with_device(sub.add_parser("new-device", help=VERBS["new-device"]))
    n.add_argument("codename")
    n.add_argument("--from-fastboot", action="store_true",
                   help="seed from `fastboot getvar all` on a connected device")
    n.add_argument("--force", action="store_true")
    n.set_defaults(func=lambda a: _lazy("porthole_newdevice", "cmd_new_device", a))

    b = with_device(sub.add_parser("brain", help=VERBS["brain"]))
    b.add_argument("query", nargs="*")
    b.add_argument("--scope", help="filter by scope, e.g. generic, soc:msm8998")
    b.add_argument("--subsystem")
    b.add_argument("--severity", help="law | trap | technique | fact")
    b.add_argument("--json", action="store_true")
    b.add_argument("--reindex", action="store_true",
                   help="regenerate brain/INDEX.md")
    b.set_defaults(func=lambda a: _lazy("porthole_brain", "cmd_brain", a))


def _lazy(module: str, func: str, args):
    import importlib
    return getattr(importlib.import_module(module), func)(args, ROOT)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
