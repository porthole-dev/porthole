#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""porthole-tui -- the always-open console.

Its own entry point rather than a verb, because its contract is different: it
takes the terminal, runs until you quit, and must never write to a pipe. A verb
that sometimes seizes the screen is a verb you cannot put in a script.
"""
import pathlib
import sys

if sys.version_info < (3, 8):
    sys.exit("porthole needs python 3.8 or newer; found "
             f"{sys.version.split()[0]}.")

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from porthole_tui.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], ROOT))
